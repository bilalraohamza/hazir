  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"opening_minor\" INTEGER NOT NULL DEFAULT 0, \"is_credit\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_credit\" IN (0, 1)), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), CHECK (kind IN ('expense', 'income')));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id), \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"category_id\" INTEGER NULL REFERENCES categories (id), \"to_account_id\" INTEGER NULL REFERENCES accounts (id), \"to_amount_minor\" INTEGER NULL, \"to_currency\" TEXT NULL, \"note\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"fx_day\" TEXT NULL, CHECK (kind IN ('expense', 'income', 'transfer')), CHECK (amount_minor > 0), CHECK (to_amount_minor > 0), CHECK (fx_day GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'));"
        }
      ]
    },
    {
      "name": "fx_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fx_snapshots\" (\"day\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"per_usd\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\", \"currency\"), CHECK (day GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
